# Copy to .env (gitignored) for `pnpm playground:mdx-jsx:translate:workers-ai`. Every request costs money.
# Shell variables override this file. Other worktrees link their .env to the primary checkout's copy.

# Workers AI credentials: your account ID and a token with Workers AI access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=

# Optional.
# POLYSTELLA_WORKERS_AI_MODEL=@cf/deepseek-ai/deepseek-v4.1-flash-1017
# POLYSTELLA_WORKERS_AI_ENDPOINT=
# POLYSTELLA_WORKERS_AI_MAX_TOKENS=8192
# POLYSTELLA_WORKERS_AI_BATCH_INPUT_TOKEN_BUDGET=4000
