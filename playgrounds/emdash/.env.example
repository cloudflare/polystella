# Copy to .env (gitignored) to test against real Workers AI. Every request costs money.
# Shell variables override this file.
#
# fake (default): a local server echoes "[<locale>] <text>". real: calls Workers AI.
# This file is shared by every worktree, so leaving this line out keeps them all on the free fake. Uncomment it to
# make every worktree use paid real AI, or set POLYSTELLA_AI=real in the shell for one run.
# POLYSTELLA_AI=real

# Workers AI credentials. Node uses them over HTTP. On Cloudflare they are used the same way,
# so no `wrangler login` is needed. Leave them empty there to use the remote AI binding instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=

# Optional. The playground already allows the models listed in models.mjs, with DeepSeek V4.1 Flash as the default.
# Set it to replace that list (comma-separated, the first is the default), for example to limit cost. Blank means unset.
# POLYSTELLA_AI_MODELS=@cf/deepseek-ai/deepseek-v4.1-flash-1017,@cf/ibm-granite/granite-4.0-h-micro
